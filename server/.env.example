NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=dm-interactive-table
JWT_AUDIENCE=dm-interactive-table-client
SESSION_TTL_HOURS=12
TABLE_CODE_TTL_MINUTES=720
COOKIE_SECURE=false
DATA_DIR=data
JSON_LIMIT=256kb
TRUST_PROXY=false
PUBLIC_BASE_URL=

# PostgreSQL connection used by Prisma when persistence is enabled.
# Leave unset to use the durable local JSON fallback in DATA_DIR.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dm_interactive_table?schema=public
