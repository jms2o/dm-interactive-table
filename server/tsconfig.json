{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "rootDir": "..",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "ts-node": {
    "files": true,
    "experimentalResolver": true
  }
}
