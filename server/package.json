{
  "name": "server",
  "version": "2.0.0-alpha.20",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "npm run prisma:generate && nodemon --watch src --watch ../shared --watch ../prisma --exec ts-node src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "start": "node dist/server/src/index.js"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.22.0",
    "socket.io": "^4.7.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "nodemon": "^3.1.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "overrides": {
    "@dice-roller/rpg-dice-roller": {
      "mathjs": "15.2.0"
    }
  }
}
